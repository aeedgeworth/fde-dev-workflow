{
  "description": "fde workflow hooks: orient the session in the active spec, guard irreversible operations, and keep edits formatted to the project's own standard.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" || true",
            "timeout": 5,
            "statusMessage": "Loading active spec"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/autoformat.py\" || true",
            "timeout": 15,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
