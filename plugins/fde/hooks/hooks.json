{
  "description": "fde workflow hooks: orient the session in active work and add a best-effort guard for explicit high-cost commands.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/session_start.py\"; test -f \"$S\" || exit 0; exec python3 \"$S\"",
            "timeout": 5,
            "statusMessage": "Loading active spec"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/guard.py\"; test -f \"$G\" || exit 0; exec python3 \"$G\"",
            "timeout": 5,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  }
}
